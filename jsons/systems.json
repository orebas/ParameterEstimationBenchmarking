{
	"names": [
    "biohydrogenation",
    "crauste",
    "daisy-mamil3",
    "daisy-mamil4",
    "fitzhugh-nagumo",
		"harmonic",
    "hiv",
		"lotka-volterra",
    "seir",
    "vanderpol"
	],
	"systems": [
    {
      "name": "biohydrogenation",
      "state-variables": ["x4", "x5", "x6", "x7"],
      "parameter-variables": ["k5", "k6", "k7", "k8", "k9", "k10"],
      "measurement-variables": ["y1", "y2"],
      "ode-system": { "x4": "- k5 * x4 / (k6 + x4)", "x5": "k5 * x4 / (k6 + x4) - k7 * x5/(k8 + x5 + x6)", "x6": "k7 * x5 / (k8 + x5 + x6) - k9 * x6 * (k10 - x6) / k10", "x7": "k9 * x6 * (k10 - x6) / k10"}, 
      "measurements": {"y1": "x4", "y2": "x5"}
    }, 
    {
      "name": "crauste",
      "state-variables": ["n", "e", "s", "m", "p"],
			"parameter-variables": ["muN", "muEE", "muLE", "muLL", "muM", "muP", "muPE", "muPL", "deltaNE", "deltaEL", "deltaLM", "rhoE", "rhoP"],
      "measurement-variables": ["y1", "y2", "y3", "y4"],
			"ode-system": {"n": "-1 * n * muN - n * p * deltaNE", "e": "n * p * deltaNE - e * e * muEE - e * deltaEL + e * p * rhoE", "s": "s * deltaEL - s * deltaLM - s * s * muLL - e * s * muLE", "m": "s * deltaLM - muM * m", "p": "p * p * rhoP - p * muP - e * p * muPE - s * p * muPL"},
			"measurements": {"y1": "n", "y2": "e", "y3": "s+m", "y4": "p"}
    }, 
    {
      "name": "daisy-mamil3",
      "state-variables": ["x1", "x2", "x3"],
			"parameter-variables": ["a12", "a13", "a21", "a31", "a01"],
      "measurement-variables": ["y1", "y2"],
			"ode-system": {"x1": "-(a21 + a31 + a01) * x1 + a12 * x2 + a13 * x3", "x2": "a21 * x1 - a12 * x2", "x3": "a31 * x1 - a13 * x3"},
			"measurements": {"y1": "x1", "y2": "x2"}
    }, 
    {
      "name": "daisy-mamil4",
      "state-variables": ["x1", "x2", "x3", "x4"],
      "parameter-variables": ["k01", "k12", "k13", "k14", "k21", "k31", "k41"],
      "measurement-variables": ["y1", "y2", "y3"],
      "ode-system": { "x1": "-k01 * x1 + k12 * x2 + k13 * x3 + k14 * x4 - k21 * x1 - k31 * x1 - k41 * x1", "x2": "-k12 * x2 + k21 * x1", "x3": "-k13 * x3 + k31 * x1", "x4": "-k14 * x4 + k41 * x1"}, 
      "measurements": {"y1": "x1", "y2": "x2", "y3": "x3 + x4"}
    },
    {
      "name": "fitzhugh-nagumo",
      "state-variables": ["V", "R"],
                       "parameter-variables": ["g", "a", "b"],
      "measurement-variables": ["y1"],
                       "ode-system": {"V": "g * (V - V^3 / 3 + R)", "R": "1 / g * (V - a + b * R)"},
                       "measurements": { "y1": "V" }
    }, 
		{
			"name": "harmonic",
			"state-variables": ["x1", "x2"],
			"parameter-variables": ["a", "b"],
      "measurement-variables": ["y1", "y2"],
			"ode-system": {"x1": "-a*x2", "x2": "+x1/b"},
			"measurements": {"y1": "x1", "y2": "x2"}
		},
    {
      "name": "hiv",
      "state-variables": ["x", "yy", "vv", "w", "z"],
			"parameter-variables": ["lm", "d", "beta", "a", "k", "uu", "c", "q", "b", "h"],
      "measurement-variables": ["y1", "y2", "y3", "y4"],
			"ode-system": {"x": "lm - d * x - beta * x * vv", "yy": "beta * x * vv - a * yy", "vv": "k * yy - uu * vv", "w": "c * x * yy * w - c * q * yy * w - b * w", "z": "c * q * yy * w - h * z"},
			"measurements": {"y1": "w", "y2": "z", "y3": "x", "y4": "yy+vv"}
    }, 
		{
			"name": "lotka-volterra",
			"state-variables": ["r", "w"],
			"parameter-variables": ["k1", "k2", "k3"],
      "measurement-variables": ["y1"],
			"ode-system": {"r": "k1*r - k2*r*w", "w": "k2*r*w - k3*w"},
			"measurements": { "y1": "r" }
		},
    {
      "name": "seir",
      "state-variables": ["S", "E", "In", "NN"],
      "parameter-variables": ["a", "b", "nu"],
      "measurement-variables": ["y1", "y2"],
      "ode-system": { "S": "-b * S * In / NN", "E": "b * S * In / NN - nu * E", "In": "nu * E - a * In", "NN": "0" },
      "measurements": { "y1": "In", "y2": "NN" }
    }, 
    {
      "name": "vanderpol",
      "state-variables": ["x1", "x2"],
			"parameter-variables": ["a", "b"],
      "measurement-variables": ["y1", "y2"],
			"ode-system": {"x1": "a * x2", "x2": "-(x1) - b * (x1^2 - 1) * (x2)"},
			"measurements": {"y1": "x1", "y2": "x2"}
    } 
	]
}
